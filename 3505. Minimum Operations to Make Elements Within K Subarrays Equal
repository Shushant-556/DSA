
import java.util.*;

class Solution {

    TreeMap<Integer, Integer> left = new TreeMap<>();
    TreeMap<Integer, Integer> right = new TreeMap<>();

    long leftSum = 0, rightSum = 0;
    int leftSize = 0, rightSize = 0;

    void addLeft(int val) {
        left.merge(val, 1, Integer::sum);
        leftSum += val;
        leftSize++;
    }

    void addRight(int val) {
        right.merge(val, 1, Integer::sum);
        rightSum += val;
        rightSize++;
    }

    void removeLeft(int val) {
        if (left.get(val) == 1)
            left.remove(val);
        else
            left.put(val, left.get(val) - 1);

        leftSum -= val;
        leftSize--;
    }

    void removeRight(int val) {
        if (right.get(val) == 1)
            right.remove(val);
        else
            right.put(val, right.get(val) - 1);

        rightSum -= val;
        rightSize--;
    }

    void balance() {
        int target = (leftSize + rightSize + 1) / 2;

        while (leftSize > target) {
            int val = left.lastKey();
            removeLeft(val);
            addRight(val);
        }

        while (leftSize < target) {
            int val = right.firstKey();
            removeRight(val);
            addLeft(val);
        }
    }

    void add(int val) {
        if (left.isEmpty() || val <= left.lastKey())
            addLeft(val);
        else
            addRight(val);

        balance();
    }

    void remove(int val) {
        if (left.containsKey(val))
            removeLeft(val);
        else
            removeRight(val);

        balance();
    }

    long getCost() {
        long median = left.lastKey();

        return median * leftSize - leftSum
             + rightSum - median * rightSize;
    }

    public long minOperations(int[] nums, int x, int k) {

        int n = nums.length;

        // Step 1: Calculate cost of every window of size x
        long[] cost = new long[n - x + 1];

        for (int i = 0; i < x; i++)
            add(nums[i]);

        cost[0] = getCost();

        for (int i = x; i < n; i++) {
            remove(nums[i - x]);
            add(nums[i]);

            cost[i - x + 1] = getCost();
        }

        // Step 2: DP to select k non-overlapping windows
        long INF = Long.MAX_VALUE / 4;

        long[][] dp = new long[k + 1][n + 1];

        for (int j = 1; j <= k; j++)
            Arrays.fill(dp[j], INF);

        for (int j = 1; j <= k; j++) {
            for (int i = 1; i <= n; i++) {

                // Skip current element
                dp[j][i] = dp[j][i - 1];

                // Select window ending at i
                if (i >= x && dp[j - 1][i - x] != INF) {
                    dp[j][i] = Math.min(
                        dp[j][i],
                        dp[j - 1][i - x] + cost[i - x]
                    );
                }
            }
        }

        return dp[k][n];
    }
}
