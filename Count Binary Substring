class Solution {
    public int countBinarySubstrings(String s) {
        int count=0;
        int cursgrp=1;
        int prevsgrp=0;
        for(int i=0;i<s.length()-1;i++){
            if(s.charAt(i)==s.charAt(i+1)){
                cursgrp++;
            }
            else{
                prevsgrp=cursgrp;
                cursgrp=1;
            }
            if(cursgrp<=prevsgrp){
                count++;
            }
        }
        return count;

    }
}
