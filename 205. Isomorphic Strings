class Solution {
    public boolean isIsomorphic(String s, String t) {
        if(s.length()!=t.length()) return false;
        int ns[]=new int[256];
        int nt[]=new int[256];
        for(int i=0;i<s.length();i++){
            if(ns[s.charAt(i)]!=nt[t.charAt(i)]) return false;
            ns[s.charAt(i)]=i+1;
            nt[t.charAt(i)]=i+1;
        }
        return true;
        
    }
}
