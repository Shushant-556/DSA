class Solution {
    public int compress(char[] chars) {
        char cd=0;
        int c=0;
        int j=0;
        for(int i=0;i<chars.length;i++){
            if(c==0){
                cd=chars[i];
                c=1;
            }
            else if(chars[i]==cd){
                c++;
            }
            else{
                chars[j]=cd;
                j++;
                if(c>1){
                    String str=String.valueOf(c);
                    for(int k=0;k<str.length();k++){
                        chars[j]=str.charAt(k);
                        j++;
                    }
                }
                cd = chars[i];
                c= 1;
            }

        }
        if(c>0){
            chars[j]=cd;
            j++;
            if(c>1){
                    String str=String.valueOf(c);
                    for(int k=0;k<str.length();k++){
                        chars[j]=str.charAt(k);
                        j++;
                    }
            }
        }
        return j;
        
    }
}
