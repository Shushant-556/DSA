class Solution {
    public int majorityElement(int[] nums) {
       int cd=0;
       int c=0;
        for(int i=0;i<nums.length;i++){
            if(c==0){
                cd=nums[i];
                c++;
            }
            else if(nums[i]==cd){
                c++;
            }
            else{
                c--;
            }
        }
        int cn=0;
        for(int j=0;j<nums.length;j++){
            if(nums[j]==cd){
                cn++;
            }
        }
        if(cn>nums.length/2){
            return cd;
        }
        return -1;
    }
}
