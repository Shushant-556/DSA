
class Solution {
    public int findShortestSubArray(int[] nums) {
        int n = nums.length;
        int[] freq = new int[n];
        int[] first = new int[n];
        int min = nums[0];
        int max = nums[0];
        for (int x : nums) {
            min = Math.min(min, x);
            max = Math.max(max, x);
        }
        int range = max - min + 1;
        freq = new int[range];
        first = new int[range];
        for (int i = 0; i < range; i++) {
            first[i] = -1;
        }
        int degree = 0;
        int ans = n;
        for (int i = 0; i < n; i++) {
            int index = nums[i] - min;
            freq[index]++;
            if (first[index] == -1) {
                first[index] = i;
            }
            if (freq[index] > degree) {
                degree = freq[index];
                ans = i - first[index] + 1;
            } else if (freq[index] == degree) {
                ans = Math.min(ans, i - first[index] + 1);
            }
        }
        return ans;
    }
}
