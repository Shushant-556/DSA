class Solution {
public:
    int searchInsert(vector<int>& nums, int target) {
        int l=0;
        int h=nums.size()-1;
        int mid=0;
        if(target<nums[0]) return 0;
        if(target>nums[nums.size()-1]) return nums.size();
        while (l<=h){
            mid=l+(h-l)/2;
            if(nums[mid]==target){
                return mid;
            }
            else if(nums[mid]<target){
                l=mid+1;
                if(nums[l]>target) return l;
            }
            else{
                h=mid-1;
                if(nums[h]<target) return mid;
            }
        }
        return -1;
    }
};
