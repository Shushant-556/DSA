
class Solution {
    public List<Integer> findDuplicates(int[] nums) {
        int n = nums.length;
        int index;
        List<Integer> arr=new ArrayList<>();
        for(int i=0;i<n;i++){
            index=Math.abs(nums[i])-1;
            if(nums[index]<0){
                arr.add(index+1);
            }
            else{
                nums[index]=-nums[index];
            }
        }
        return arr;
    }
}
