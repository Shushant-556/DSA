class Solution {
    public int sumCounts(int[] nums) {
        int n = nums.length;
        long mod = 1_000_000_007L;

        long[] sum = new long[4 * n];
        long[] lazy = new long[4 * n];
        long[] square = new long[4 * n];

        int[] last = new int[100001];
        long ans = 0;

        for (int i = 0; i < n; i++) {
            int x = nums[i];
            int prev = last[x];
            last[x] = i + 1;

            update(1, 0, n - 1, prev, i, sum, square, lazy, mod);

            ans = (ans + square[1]) % mod;
        }

        return (int) ans;
    }

    private void push(int node, int l, int r, long[] sum,
                      long[] square, long[] lazy, long mod) {
        if (lazy[node] == 0 || l == r) return;

        int mid = (l + r) / 2;
        apply(node * 2, l, mid, lazy[node], sum, square, lazy, mod);
        apply(node * 2 + 1, mid + 1, r, lazy[node], sum, square, lazy, mod);
        lazy[node] = 0;
    }

    private void apply(int node, int l, int r, long v, long[] sum,
                       long[] square, long[] lazy, long mod) {
        long len = r - l + 1L;
        square[node] = (square[node] + 2 * v % mod * sum[node] % mod
                + len % mod * v % mod * v) % mod;
        sum[node] = (sum[node] + len * v) % mod;
        lazy[node] = (lazy[node] + v) % mod;
    }

    private void update(int node, int l, int r, int ql, int qr,
                        long[] sum, long[] square, long[] lazy, long mod) {
        if (ql > r || qr < l) return;

        if (ql <= l && r <= qr) {
            apply(node, l, r, 1, sum, square, lazy, mod);
            return;
        }

        push(node, l, r, sum, square, lazy, mod);

        int mid = (l + r) / 2;
        update(node * 2, l, mid, ql, qr, sum, square, lazy, mod);
        update(node * 2 + 1, mid + 1, r, ql, qr, sum, square, lazy, mod);

        sum[node] = (sum[node * 2] + sum[node * 2 + 1]) % mod;
        square[node] = (square[node * 2] + square[node * 2 + 1]) % mod;
    }
}
